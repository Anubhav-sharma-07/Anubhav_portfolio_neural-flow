# Server Configuration
PORT=5000

# Google Sheets API (Service Account)
# Note: Share your Google Sheet with the client email address as Editor
GOOGLE_SHEETS_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# For the private key, copy the entire key block including the BEGIN and END lines, wrapping it in quotes
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your-google-sheet-id-from-url

# SerpAPI (Google Search Leads)
SERPAPI_KEY=your-serpapi-key

# Apify API
APIFY_API_TOKEN=your-apify-api-token
# The ID of the LinkedIn or Instagram scraper actor you wish to use
APIFY_LINKEDIN_ACTOR_ID=apify/instagram-scraper

# Anthropic Claude API
CLAUDE_API_KEY=your-claude-api-key

# Gmail API (OAuth2) - Required for sending outreach and checking replies
GMAIL_CLIENT_ID=your-gmail-client-id
GMAIL_CLIENT_SECRET=your-gmail-client-secret
GMAIL_REFRESH_TOKEN=your-gmail-refresh-token

# Optional: Notifications (Telegram Bot)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
